[Unit]
Description=Lectern: watch job boards and post new listings to Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lectern
Group=lectern
WorkingDirectory=/home/lectern
Environment=HOME=/home/lectern
ExecStart=/home/lectern/bin/run-lectern.sh
TimeoutStartSec=1h
# Share the box politely with the auditor and ai-jobs (2 cores, 3.8 GB)
Nice=10
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=1G
# Sandbox: network and /home/lectern, nothing else
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/lectern
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
